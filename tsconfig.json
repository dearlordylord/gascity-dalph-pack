{
  "compilerOptions": {
    "incremental": true,
    "composite": false,
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "node"
    ],
    "outDir": "dist",
    "sourceMap": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "globalConsole": "error",
          "globalConsoleInEffect": "error"
        }
      }
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "dashboard/**/*.ts",
    "vitest.config.ts",
    "vitest.native.config.ts",
    "trial/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "examples",
    "trial/seed"
  ]
}
