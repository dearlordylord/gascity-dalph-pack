+func TestExecutionBackstopRespectsFiniteRuntimeHeartbeat(t *testing.T) {
+	f := newExecutionBackstopFixture(t)
+	f.cfg.Agents[0].Nudge = ""
+	f.idleFor(t, 10*time.Minute)
+	until := f.now.Add(10 * time.Minute)
+	if err := f.store.SetMetadata(f.session.ID, "held_until", until.Format(time.RFC3339)); err != nil {
+		t.Fatal(err)
+	}
+	f.tick(t)
+	if got := f.sessionMeta(t, executionClaimNudgeWorkKey); got != "" {
+		t.Fatalf("heartbeat spent the observation budget: %q", got)
+	}
+	// Each tick reconstructs the controller predicate from durable rows.
+	f.now = f.now.Add(5 * time.Minute)
+	f.tick(t)
+	if len(f.drained) != 0 || f.nudgeCount() != 0 {
+		t.Fatal("active heartbeat did not survive controller reconstruction")
+	}
+	f.now = until.Add(time.Second)
+	f.tick(t)
+	f.now = f.now.Add(idleClaimNudgeGrace + time.Second)
+	f.tick(t)
+	if len(f.drained) != 1 {
+		t.Fatalf("expired heartbeat did not restore bounded drain: %v", f.drained)
+	}
+}
