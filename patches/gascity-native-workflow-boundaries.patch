+// Future or unreadable durable timers retain custody; expiry restores the backstop.
+func runtimeTimerHolds(s beads.Bead, now time.Time) bool {
+	holds := session.Holds(s.Metadata, now)
+	return (holds.In|holds.Unknown)&session.HoldTimer != 0
+}
