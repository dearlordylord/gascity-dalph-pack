 func (p poolExecutionBackstop) exhausted(store beads.Store, s *beads.Bead, stdout io.Writer) {
+	// A heartbeat may have been accepted after the assigned-work snapshot.
+	// Re-read its durable timer before recording escalation or requesting drain.
+	live := beads.HandlesFor(store).Live
+	if live == nil {
+		p.observeHold(store, s, backstopHoldRevalidate, stdout)
+		return
+	}
+	current, err := live.Get(s.ID)
+	if err != nil || current.ID != s.ID {
+		p.observeHold(store, s, backstopHoldRevalidate, stdout)
+		return
+	}
+	if runtimeTimerHolds(current, p.now) {
+		p.observeHold(store, s, executionHoldRuntimeTimer, stdout)
+		return
+	}
