diff --git a/internal/api/huma_metadata_cas.go b/internal/api/huma_metadata_cas.go
new file mode 100644
index 0000000..db9208f
--- /dev/null
+++ b/internal/api/huma_metadata_cas.go
@@ -0,0 +1,208 @@
+package api
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/gastownhall/gascity/internal/api/apierr"
+	"github.com/gastownhall/gascity/internal/beads"
+)
+
+// BeadMetadataCASInput projects the existing exact-store metadata value-CAS.
+// Pointers preserve required presence independently of the legal empty value.
+type BeadMetadataCASInput struct {
+	CityScope
+	ID   string `path:"id" maxLength:"512" pattern:"^[A-Za-z0-9][A-Za-z0-9._-]*$"`
+	Body struct {
+		StoreRef *string `json:"store_ref" nullable:"false"`
+		Key      *string `json:"key" nullable:"false"`
+		Expected *string `json:"expected" nullable:"false"`
+		Next     *string `json:"next" nullable:"false"`
+	}
+}
+
+// BeadMetadataCASOutput is byte-shape compatible with gc beads metadata-cas.
+// Conflict is a successful observation, not an acknowledgement of a write.
+type BeadMetadataCASOutput struct {
+	Body struct {
+		SchemaVersion string                   `json:"schema_version" enum:"1"`
+		OK            bool                     `json:"ok"`
+		BeadID        string                   `json:"bead_id"`
+		StoreRef      string                   `json:"store_ref"`
+		Key           string                   `json:"key"`
+		Outcome       beads.MetadataCASOutcome `json:"outcome" enum:"swapped,already_next,conflict"`
+	}
+}
+
+func metadataCASToken(value string, limit int) bool {
+	if len(value) == 0 || len(value) > limit {
+		return false
+	}
+	for i, c := range []byte(value) {
+		if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' {
+			continue
+		}
+		if i > 0 && (c == '.' || c == '_' || c == '-') {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+// metadataCASKey is the common key spelling accepted by the scoped GC CLI
+// and the pinned bd write leaf. GC's token grammar alone permits hyphens and
+// leading digits that bd refuses; reject those before any store operation.
+func metadataCASKey(value string) bool {
+	if !metadataCASToken(value, 256) || strings.Contains(value, "-") {
+		return false
+	}
+	first := value[0]
+	return first >= 'a' && first <= 'z' || first >= 'A' && first <= 'Z'
+}
+
+// metadataCASStore pins one controller-owned store. It neither opens nor closes
+// handles: the controller retains their capability cache and lifecycle ownership.
+func (s *Server) metadataCASStore(ref string) (beads.Store, error) {
+	kind, name, ok := strings.Cut(ref, ":")
+	if !ok || !metadataCASToken(name, 255) {
+		return nil, apierr.InvalidRequest.Msg("invalid store_ref")
+	}
+	var store beads.Store
+	switch kind {
+	case "city":
+		if name != s.state.CityName() {
+			return nil, apierr.InvalidRequest.Msg("store_ref names another city")
+		}
+		store = s.state.CityBeadStore()
+	case "rig":
+		cfg := s.state.Config()
+		if cfg == nil {
+			return nil, apierr.Internal.Msg("city configuration unavailable")
+		}
+		found := false
+		for _, rig := range cfg.Rigs {
+			if rig.Name == name && strings.TrimSpace(rig.Path) != "" {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return nil, apierr.InvalidRequest.Msg("store_ref names an unconfigured local rig")
+		}
+		store = s.state.BeadStore(name)
+	default:
+		return nil, apierr.InvalidRequest.Msg("store_ref requires city:<name> or rig:<name>")
+	}
+	if store == nil {
+		return nil, apierr.Internal.Msg("exact store unavailable")
+	}
+	return store, nil
+}
+
+// metadataCASFreshStore keeps writes through the declared capability (including
+// cache invalidation and the existing conditional write-leaf policy), while
+// false-CAS classification reads the same held store below projection caches.
+type metadataCASFreshStore struct{ beads.Store }
+
+func (s metadataCASFreshStore) CompareAndSetMetadataKey(id, key, expected, next string) (bool, error) {
+	writer, ok := beads.MetadataCASWriterFor(s.Store)
+	if !ok {
+		return false, beads.ErrConditionalWriteUnsupported
+	}
+	return writer.CompareAndSetMetadataKey(id, key, expected, next)
+}
+func (s metadataCASFreshStore) Get(id string) (beads.Bead, error) {
+	store := s.Store
+	for range 16 {
+		switch current := store.(type) {
+		case *beads.CachingStore:
+			store = current.Backing()
+		case beads.ConditionalWritesResolveTargeter:
+			store = current.ConditionalWritesResolveTarget()
+		default:
+			b, err := store.Get(id)
+			if err == nil && b.ID != id {
+				return beads.Bead{}, fmt.Errorf("exact store returned another bead")
+			}
+			return b, err
+		}
+		if store == nil {
+			return beads.Bead{}, fmt.Errorf("exact store backing unavailable")
+		}
+	}
+	return beads.Bead{}, fmt.Errorf("exact store wrapper chain unresolved")
+}
+
+func (s *Server) humaHandleBeadMetadataCAS(_ context.Context, input *BeadMetadataCASInput) (*BeadMetadataCASOutput, error) {
+	b := input.Body
+	if b.StoreRef == nil || b.Key == nil || b.Expected == nil || b.Next == nil {
+		return nil, apierr.InvalidRequest.Msg("store_ref, key, expected and next are required")
+	}
+	if !metadataCASToken(input.ID, 512) || !metadataCASKey(*b.Key) {
+		return nil, apierr.InvalidRequest.Msg("invalid bead id or metadata key")
+	}
+	if !utf8.ValidString(*b.Expected) || !utf8.ValidString(*b.Next) || len(*b.Expected) > 64*1024 || len(*b.Next) > 64*1024 {
+		return nil, apierr.InvalidRequest.Msg("metadata values must be UTF-8 and at most 65536 bytes")
+	}
+	store, err := s.metadataCASStore(*b.StoreRef)
+	if err != nil {
+		return nil, err
+	}
+	outcome, err := beads.ApplyMetadataCAS(metadataCASFreshStore{store}, input.ID, *b.Key, *b.Expected, *b.Next)
+	if err != nil {
+		if errors.Is(err, beads.ErrConditionalWriteUnsupported) {
+			return nil, apierr.NotImplemented.Msg(err.Error())
+		}
+		if errors.Is(err, beads.ErrNotFound) {
+			return nil, apierr.BeadNotFound.Msg(err.Error())
+		}
+		return nil, apierr.Internal.Msg(err.Error())
+	}
+	out := &BeadMetadataCASOutput{}
+	out.Body.SchemaVersion = "1"
+	out.Body.OK = true
+	out.Body.BeadID = input.ID
+	out.Body.StoreRef = *b.StoreRef
+	out.Body.Key = *b.Key
+	out.Body.Outcome = outcome
+	return out, nil
+}
+
+// BeadMetadataCASCapabilityInput selects exactly the same held store as POST.
+type BeadMetadataCASCapabilityInput struct {
+	CityScope
+	StoreRef string `query:"store_ref" required:"true"`
+}
+type BeadMetadataCASCapabilityOutput struct {
+	Body struct {
+		SchemaVersion string `json:"schema_version" enum:"1"`
+		OK            bool   `json:"ok"`
+		StoreRef      string `json:"store_ref"`
+		Capability    string `json:"capability" enum:"metadata-value-cas-v1"`
+		Supported     bool   `json:"supported"`
+	}
+}
+
+func (s *Server) humaHandleMetadataCASCapability(_ context.Context, input *BeadMetadataCASCapabilityInput) (*BeadMetadataCASCapabilityOutput, error) {
+	store, err := s.metadataCASStore(input.StoreRef)
+	if err != nil {
+		return nil, err
+	}
+	if err := beads.ProbeMetadataCAS(store); err != nil {
+		if errors.Is(err, beads.ErrConditionalWriteUnsupported) {
+			return nil, apierr.NotImplemented.Msg(err.Error())
+		}
+		return nil, apierr.Internal.Msg(err.Error())
+	}
+	out := &BeadMetadataCASCapabilityOutput{}
+	out.Body.SchemaVersion = "1"
+	out.Body.OK = true
+	out.Body.StoreRef = input.StoreRef
+	out.Body.Capability = "metadata-value-cas-v1"
+	out.Body.Supported = true
+	return out, nil
+}
diff --git a/internal/api/huma_metadata_cas_test.go b/internal/api/huma_metadata_cas_test.go
new file mode 100644
index 0000000..a82152b
--- /dev/null
+++ b/internal/api/huma_metadata_cas_test.go
@@ -0,0 +1,292 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"github.com/gastownhall/gascity/internal/beads"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+func TestMetadataCASHTTPRequiresExactScope(t *testing.T) {
+	state := newFakeState(t)
+	h := newTestCityHandler(t, state)
+	req := httptest.NewRequest(http.MethodPost, cityURL(state, "/bead/gc-1/metadata-cas"), strings.NewReader(`{"store_ref":"rig:foreign","key":"k","expected":"","next":"v"}`))
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-GC-Request", "1")
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	if rec.Code != http.StatusBadRequest {
+		t.Fatalf("status=%d body=%s", rec.Code, rec.Body.String())
+	}
+}
+
+func casHTTP(t *testing.T, h http.Handler, state State, id, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodPost, cityURL(state, "/bead/"+id+"/metadata-cas"), strings.NewReader(body))
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-GC-Request", "1")
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	return rec
+}
+func casBody(ref, expected, next string) string {
+	b, _ := json.Marshal(struct {
+		StoreRef string `json:"store_ref"`
+		Key      string `json:"key"`
+		Expected string `json:"expected"`
+		Next     string `json:"next"`
+	}{ref, "k", expected, next})
+	return string(b)
+}
+func requireCAS(t *testing.T, rec *httptest.ResponseRecorder, id, ref, outcome string) {
+	t.Helper()
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status=%d body=%s", rec.Code, rec.Body.String())
+	}
+	var got struct {
+		SchemaVersion string `json:"schema_version"`
+		OK            bool   `json:"ok"`
+		BeadID        string `json:"bead_id"`
+		StoreRef      string `json:"store_ref"`
+		Key           string `json:"key"`
+		Outcome       string `json:"outcome"`
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.SchemaVersion != "1" || !got.OK || got.BeadID != id || got.StoreRef != ref || got.Key != "k" || got.Outcome != outcome {
+		t.Fatalf("receipt=%+v", got)
+	}
+}
+func TestMetadataCASHTTPScopeReplayAndConflict(t *testing.T) {
+	state := newFakeState(t)
+	city := beads.NewMemStore()
+	state.cityBeadStore = city
+	row, err := state.stores["myrig"].Create(beads.Bead{Title: "task", Metadata: map[string]string{"retained": "original"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	shadow, err := city.Create(beads.Bead{Title: "foreign", Metadata: map[string]string{"k": "foreign"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if shadow.ID != row.ID {
+		t.Fatal("fixture needs colliding IDs")
+	}
+	h := newTestCityHandler(t, state)
+	for _, step := range []struct{ expected, next, outcome string }{{"", "v", "swapped"}, {"", "v", "already_next"}, {"", "other", "conflict"}, {"v", "", "swapped"}, {"", "again", "swapped"}} {
+		requireCAS(t, casHTTP(t, h, state, row.ID, casBody("rig:myrig", step.expected, step.next)), row.ID, "rig:myrig", step.outcome)
+	}
+	fresh, _ := city.Get(row.ID)
+	if fresh.Metadata["k"] != "foreign" {
+		t.Fatal("foreign store mutated")
+	}
+	fresh, _ = state.stores["myrig"].Get(row.ID)
+	if fresh.Metadata["retained"] != "original" {
+		t.Fatal("unrelated metadata changed")
+	}
+	requireCAS(t, casHTTP(t, h, state, row.ID, casBody("city:test-city", "foreign", "city-value")), row.ID, "city:test-city", "swapped")
+}
+func TestMetadataCASHTTPPresenceAndUnavailable(t *testing.T) {
+	state := newFakeState(t)
+	h := newTestCityHandler(t, state)
+	for _, body := range []string{`{}`, `{"store_ref":"rig:myrig","key":"k","next":"v"}`, `{"store_ref":"rig:myrig","key":"k","expected":null,"next":"v"}`, casBody("city:foreign", "", "v"), casBody("rig:missing", "", "v")} {
+		rec := casHTTP(t, h, state, "gc-1", body)
+		if rec.Code < 400 {
+			t.Fatalf("accepted %s", body)
+		}
+	}
+	rec := casHTTP(t, h, state, "gc-missing", casBody("rig:myrig", "", "v"))
+	if rec.Code != 404 {
+		t.Fatalf("missing=%d %s", rec.Code, rec.Body.String())
+	}
+	state.stores["myrig"] = nil
+	rec = casHTTP(t, h, state, "gc-1", casBody("rig:myrig", "", "v"))
+	if rec.Code < 500 {
+		t.Fatalf("unavailable=%d", rec.Code)
+	}
+}
+
+type casLostStore struct {
+	beads.Store
+	lost bool
+}
+
+func (s *casLostStore) CompareAndSetMetadataKey(id, key, expected, next string) (bool, error) {
+	w, _ := beads.MetadataCASWriterFor(s.Store)
+	swapped, err := w.CompareAndSetMetadataKey(id, key, expected, next)
+	if err == nil && swapped && !s.lost {
+		s.lost = true
+		return false, errors.New("response lost after commit")
+	}
+	return swapped, err
+}
+func TestMetadataCASHTTPLostResponseIsNotAcknowledged(t *testing.T) {
+	state := newFakeState(t)
+	base := state.stores["myrig"]
+	row, _ := base.Create(beads.Bead{Title: "task"})
+	state.stores["myrig"] = &casLostStore{Store: base}
+	h := newTestCityHandler(t, state)
+	rec := casHTTP(t, h, state, row.ID, casBody("rig:myrig", "", "v"))
+	if rec.Code < 500 {
+		t.Fatal("ambiguous response acknowledged")
+	}
+	requireCAS(t, casHTTP(t, h, state, row.ID, casBody("rig:myrig", "", "v")), row.ID, "rig:myrig", "already_next")
+}
+func TestMetadataCASHTTPFreshClassificationThroughCache(t *testing.T) {
+	state := newFakeState(t)
+	base := state.stores["myrig"]
+	row, _ := base.Create(beads.Bead{Title: "task", Metadata: map[string]string{"k": "stale"}})
+	cache := beads.NewCachingStore(base, nil)
+	if err := cache.Prime(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	state.stores["myrig"] = cache
+	if err := base.SetMetadata(row.ID, "k", "fresh"); err != nil {
+		t.Fatal(err)
+	}
+	h := newTestCityHandler(t, state)
+	requireCAS(t, casHTTP(t, h, state, row.ID, casBody("rig:myrig", "", "fresh")), row.ID, "rig:myrig", "already_next")
+	requireCAS(t, casHTTP(t, h, state, row.ID, casBody("rig:myrig", "", "stale")), row.ID, "rig:myrig", "conflict")
+}
+func TestMetadataCASHTTPHeldBdStoreProbesOnceAndReplacementReprobes(t *testing.T) {
+	for _, id := range []string{"fi-one", "fi-wisp-one"} {
+		t.Run(id, func(t *testing.T) {
+			state := newFakeState(t)
+			probes, writes := 0, 0
+			value := ""
+			revision := int64(-7151513277199971023)
+			runner := func(_ string, _ string, args ...string) ([]byte, error) {
+				if len(args) > 1 && args[1] == "--help" {
+					probes++
+					return []byte("--if-revision"), nil
+				}
+				switch args[0] {
+				case "show":
+					return []byte(fmt.Sprintf(`[{"id":%q,"status":"open","revision":"%d","metadata":{"k":%q}}]`, id, revision, value)), nil
+				case "update":
+					found := false
+					for i, a := range args {
+						if a == "--if-revision" {
+							found = true
+							if args[i+1] != strconv.FormatInt(revision, 10) {
+								t.Fatal("wrong fence")
+							}
+						}
+						if a == "--set-metadata" {
+							value = strings.TrimPrefix(args[i+1], "k=")
+						}
+					}
+					if !found {
+						t.Fatal("unfenced write")
+					}
+					writes++
+					revision++
+					return []byte(`[]`), nil
+				default:
+					t.Fatalf("unexpected command %v", args)
+					return nil, nil
+				}
+			}
+			state.stores["myrig"] = beads.NewBdStore("/owned-rig", runner)
+			h := newTestCityHandler(t, state)
+			capability := func() {
+				t.Helper()
+				r := httptest.NewRecorder()
+				h.ServeHTTP(r, httptest.NewRequest("GET", cityURL(state, "/metadata-cas-capability?store_ref=rig:myrig"), nil))
+				if r.Code != 200 || !strings.Contains(r.Body.String(), `"capability":"metadata-value-cas-v1"`) {
+					t.Fatalf("capability %d %s", r.Code, r.Body.String())
+				}
+			}
+			capability()
+			requireCAS(t, casHTTP(t, h, state, id, casBody("rig:myrig", "", "v")), id, "rig:myrig", "swapped")
+			requireCAS(t, casHTTP(t, h, state, id, casBody("rig:myrig", "", "v")), id, "rig:myrig", "already_next")
+			capability()
+			if probes != 4 || writes != 1 {
+				t.Fatalf("probes=%d writes=%d", probes, writes)
+			}
+			state.stores["myrig"] = beads.NewBdStore("/owned-rig", runner)
+			capability()
+			if probes != 8 {
+				t.Fatalf("replacement probes=%d", probes)
+			}
+
+		})
+	}
+}
+
+func TestMetadataCASHTTPUnsupportedRuntimeLatchAndEphemeralID(t *testing.T) {
+	state := newFakeState(t)
+	probes, writes := 0, 0
+	state.stores["myrig"] = beads.NewBdStore("/owned-rig", func(_ string, _ string, args ...string) ([]byte, error) {
+		if len(args) > 1 && args[1] == "--help" {
+			probes++
+			return []byte("--if-revision"), nil
+		}
+		if args[0] == "show" {
+			return []byte(`[{"id":"fi-wisp-one","status":"open","revision":1,"metadata":{}}]`), nil
+		}
+		if args[0] == "update" {
+			writes++
+			return nil, errors.New("exit status 1: unknown flag: --if-revision")
+		}
+		t.Fatalf("unexpected %v", args)
+		return nil, nil
+	})
+	h := newTestCityHandler(t, state)
+	for range 2 {
+		rec := casHTTP(t, h, state, "fi-wisp-one", casBody("rig:myrig", "", "v"))
+		if rec.Code != 501 {
+			t.Fatalf("status=%d body=%s", rec.Code, rec.Body.String())
+		}
+	}
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, httptest.NewRequest("GET", cityURL(state, "/metadata-cas-capability?store_ref=rig:myrig"), nil))
+	if rec.Code != 501 || probes != 4 || writes != 1 {
+		t.Fatalf("capability status=%d probes=%d writes=%d", rec.Code, probes, writes)
+	}
+}
+func TestMetadataCASHTTPMutationAdmission(t *testing.T) {
+	state := newFakeState(t)
+	row, _ := state.stores["myrig"].Create(beads.Bead{Title: "task"})
+	for i, h := range []http.Handler{newTestCityHandler(t, state), newTestCityHandlerReadOnly(t, state)} {
+		req := httptest.NewRequest("POST", cityURL(state, "/bead/"+row.ID+"/metadata-cas"), strings.NewReader(casBody("rig:myrig", "", "v")))
+		req.Header.Set("Content-Type", "application/json")
+		if i == 1 {
+			req.Header.Set("X-GC-Request", "1")
+		}
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, req)
+		if rec.Code != 403 {
+			t.Fatalf("unguarded status=%d body=%s", rec.Code, rec.Body.String())
+		}
+	}
+	fresh, _ := state.stores["myrig"].Get(row.ID)
+	if fresh.Metadata["k"] != "" {
+		t.Fatal("admission bypassed")
+	}
+}
+
+func TestMetadataCASHTTPRefusesKeysRejectedByBDWithoutStoreEffects(t *testing.T) {
+	state := newFakeState(t)
+	state.stores["myrig"] = beads.NewBdStore("/owned-rig", func(string, string, ...string) ([]byte, error) { t.Fatal("invalid key reached store"); return nil, nil })
+	h := newTestCityHandler(t, state)
+	for _, key := range []string{"dalph.http-proof", "7key", "_key", "path/key", "", "a b"} {
+		body, _ := json.Marshal(struct {
+			StoreRef string `json:"store_ref"`
+			Key      string `json:"key"`
+			Expected string `json:"expected"`
+			Next     string `json:"next"`
+		}{"rig:myrig", key, "", "value"})
+		rec := casHTTP(t, h, state, "fi-one", string(body))
+		if rec.Code != 400 {
+			t.Fatalf("key=%q status=%d body=%s", key, rec.Code, rec.Body.String())
+		}
+	}
+}
diff --git a/internal/api/huma_scoped_read.go b/internal/api/huma_scoped_read.go
new file mode 100644
index 0000000..26ca28c
--- /dev/null
+++ b/internal/api/huma_scoped_read.go
@@ -0,0 +1,118 @@
+package api
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"strings"
+
+	"github.com/gastownhall/gascity/internal/api/apierr"
+	"github.com/gastownhall/gascity/internal/beads"
+)
+
+// ScopedReadInput names an exact local rig. CITY logical residency is deliberately
+// outside this surface: a CITY shadow must not answer for a relocated class.
+type ScopedReadInput struct {
+	CityScope
+	StoreRef string `query:"store_ref" required:"true" doc:"Exact local rig locator (rig:name)."`
+}
+
+type ScopedBeadReadInput struct {
+	ScopedReadInput
+	ID string `path:"id" maxLength:"512" pattern:"^[A-Za-z0-9][A-Za-z0-9._-]*$"`
+}
+
+type ScopedBeadReadOutput struct {
+	Body struct {
+		SchemaVersion string     `json:"schema_version" enum:"1"`
+		OK            bool       `json:"ok"`
+		StoreRef      string     `json:"store_ref"`
+		Bead          beads.Bead `json:"bead"`
+		Revision      string     `json:"revision" pattern:"^-?[1-9][0-9]*$" doc:"Opaque signed row token from this same live observation; equality only."`
+	}
+}
+
+type ScopedBeadsReadOutput struct {
+	Body struct {
+		SchemaVersion string       `json:"schema_version" enum:"1"`
+		OK            bool         `json:"ok"`
+		StoreRef      string       `json:"store_ref"`
+		Beads         []beads.Bead `json:"beads"`
+	}
+}
+
+type ScopedReadCapabilityOutput struct {
+	Body struct {
+		SchemaVersion string `json:"schema_version" enum:"1"`
+		OK            bool   `json:"ok"`
+		StoreRef      string `json:"store_ref"`
+		Capability    string `json:"capability" enum:"exact-live-beads-v1"`
+		Supported     bool   `json:"supported"`
+	}
+}
+
+// Keep the held controller store and its Live reader. In particular, do not
+// follow ConditionalWritesResolveTarget: that is the write leaf, not the native
+// read authority. HandlesFor preserves policy wrappers and cache bypass.
+func (s *Server) scopedLiveReader(ref string) (beads.LiveReader, error) {
+	if !strings.HasPrefix(ref, "rig:") {
+		return nil, apierr.InvalidRequest.Msg("exact live reads require rig:<name>; CITY logical reads are not supported")
+	}
+	store, err := s.metadataCASStore(ref)
+	if err != nil {
+		return nil, err
+	}
+	return beads.HandlesFor(store).Live, nil
+}
+
+func (s *Server) humaHandleScopedBeadRead(_ context.Context, input *ScopedBeadReadInput) (*ScopedBeadReadOutput, error) {
+	reader, err := s.scopedLiveReader(input.StoreRef)
+	if err != nil {
+		return nil, err
+	}
+	row, err := reader.Get(input.ID)
+	if errors.Is(err, beads.ErrNotFound) {
+		return nil, apierr.BeadNotFound.Msg("bead " + input.ID + " not found in " + input.StoreRef)
+	}
+	if err != nil {
+		return nil, apierr.Internal.Msg(err.Error())
+	}
+	if row.ID != input.ID {
+		return nil, apierr.Internal.Msg("exact live store returned another bead")
+	}
+	if row.Revision == 0 {
+		return nil, apierr.Internal.Msg("exact live store returned no revision token")
+	}
+	out := &ScopedBeadReadOutput{}
+	out.Body.SchemaVersion, out.Body.OK, out.Body.StoreRef = "1", true, input.StoreRef
+	out.Body.Bead, out.Body.Revision = row, strconv.FormatInt(row.Revision, 10)
+	return out, nil
+}
+
+func (s *Server) humaHandleScopedBeadsRead(_ context.Context, input *ScopedReadInput) (*ScopedBeadsReadOutput, error) {
+	reader, err := s.scopedLiveReader(input.StoreRef)
+	if err != nil {
+		return nil, err
+	}
+	rows, err := reader.List(beads.ListQuery{IncludeClosed: true, Live: true, TierMode: beads.TierBoth, AllowScan: true})
+	if err != nil {
+		return nil, apierr.Internal.Msg(err.Error())
+	}
+	if rows == nil {
+		rows = []beads.Bead{}
+	}
+	out := &ScopedBeadsReadOutput{}
+	out.Body.SchemaVersion, out.Body.OK, out.Body.StoreRef = "1", true, input.StoreRef
+	out.Body.Beads = rows
+	return out, nil
+}
+
+func (s *Server) humaHandleScopedReadCapability(_ context.Context, input *ScopedReadInput) (*ScopedReadCapabilityOutput, error) {
+	if _, err := s.scopedLiveReader(input.StoreRef); err != nil {
+		return nil, err
+	}
+	out := &ScopedReadCapabilityOutput{}
+	out.Body.SchemaVersion, out.Body.OK, out.Body.StoreRef = "1", true, input.StoreRef
+	out.Body.Capability, out.Body.Supported = "exact-live-beads-v1", true
+	return out, nil
+}
diff --git a/internal/api/huma_scoped_read_test.go b/internal/api/huma_scoped_read_test.go
new file mode 100644
index 0000000..b886c68
--- /dev/null
+++ b/internal/api/huma_scoped_read_test.go
@@ -0,0 +1,227 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gastownhall/gascity/internal/beads"
+)
+
+func exactReadRequest(t *testing.T, h http.Handler, state State, path string) *httptest.ResponseRecorder {
+	t.Helper()
+	r := httptest.NewRecorder()
+	h.ServeHTTP(r, httptest.NewRequest(http.MethodGet, cityURL(state, path), nil))
+	return r
+}
+
+type scopedReadProbe struct {
+	beads.Store
+	row                 beads.Bead
+	rows                []beads.Bead
+	err                 error
+	gets, lists, closes int
+}
+
+func (s *scopedReadProbe) Get(string) (beads.Bead, error) { s.gets++; return s.row, s.err }
+func (s *scopedReadProbe) List(q beads.ListQuery) ([]beads.Bead, error) {
+	s.lists++
+	if !q.Live || !q.IncludeClosed || q.TierMode != beads.TierBoth || !q.AllowScan || q.Limit != 0 {
+		return nil, fmt.Errorf("incorrect live full-scope query: %+v", q)
+	}
+	return s.rows, s.err
+}
+func (s *scopedReadProbe) CloseStore() error { s.closes++; return nil }
+
+// Mirrors the policy wrapper's declared reader composition. Its conditional
+// target is a different authority and must never be consulted for live reads.
+type scopedReadPolicy struct{ beads.Store }
+
+func (s scopedReadPolicy) Handles() beads.StoreHandles { return beads.HandlesFor(s.Store) }
+func (s scopedReadPolicy) ConditionalWritesResolveTarget() beads.Store {
+	panic("live read traversed the conditional write leaf")
+}
+
+func TestScopedReadHTTPExactIdentityRevisionAndDependencies(t *testing.T) {
+	state := newFakeState(t)
+	row := beads.Bead{ID: "fi-one", Status: "closed", Type: "task", Revision: -7151513277199971023,
+		Metadata:     map[string]string{"gc.session_id": "session-exact"},
+		Dependencies: []beads.Dep{{IssueID: "fi-one", DependsOnID: "fi-dep", Type: "blocks"}}}
+	probe := &scopedReadProbe{Store: state.stores["myrig"], row: row}
+	state.stores["myrig"] = scopedReadPolicy{beads.NewCachingStore(probe, nil)}
+	state.cityBeadStore = &scopedReadProbe{Store: beads.NewMemStore(), row: beads.Bead{ID: row.ID, Title: "foreign"}}
+	h := newTestCityHandler(t, state)
+	r := exactReadRequest(t, h, state, "/bead/fi-one/read-exact?store_ref=rig:myrig")
+	if r.Code != 200 {
+		t.Fatalf("%d %s", r.Code, r.Body.String())
+	}
+	var got struct {
+		SchemaVersion string     `json:"schema_version"`
+		OK            bool       `json:"ok"`
+		StoreRef      string     `json:"store_ref"`
+		Bead          beads.Bead `json:"bead"`
+		Revision      string     `json:"revision"`
+	}
+	if err := json.Unmarshal(r.Body.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.SchemaVersion != "1" || !got.OK || got.StoreRef != "rig:myrig" || got.Revision != "-7151513277199971023" || got.Bead.ID != row.ID || got.Bead.Metadata["gc.session_id"] != "session-exact" || len(got.Bead.Dependencies) != 1 || got.Bead.Dependencies[0] != row.Dependencies[0] {
+		t.Fatalf("response %+v", got)
+	}
+	if probe.gets != 1 || probe.closes != 0 || state.cityBeadStore.(*scopedReadProbe).gets != 0 {
+		t.Fatal("wrong store or ownership")
+	}
+}
+
+func TestScopedReadHTTPBypassesStaleProjectionAndUsesReplacement(t *testing.T) {
+	state := newFakeState(t)
+	base := state.stores["myrig"]
+	row, err := base.Create(beads.Bead{Title: "task", Metadata: map[string]string{"gc.session_id": "old"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	cache := beads.NewCachingStore(base, nil)
+	if err := cache.Prime(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	state.stores["myrig"] = cache
+	if err := base.SetMetadata(row.ID, "gc.session_id", "new"); err != nil {
+		t.Fatal(err)
+	}
+	if err := base.Close(row.ID); err != nil {
+		t.Fatal(err)
+	}
+	stale, _ := cache.Get(row.ID)
+	if stale.Status == "closed" || stale.Metadata["gc.session_id"] != "old" {
+		t.Fatal("fixture is not stale")
+	}
+	h := newTestCityHandler(t, state)
+	r := exactReadRequest(t, h, state, "/bead/"+row.ID+"/read-exact?store_ref=rig:myrig")
+	var got struct {
+		Bead beads.Bead `json:"bead"`
+	}
+	if err := json.Unmarshal(r.Body.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	if r.Code != 200 || got.Bead.Status != "closed" || got.Bead.Metadata["gc.session_id"] != "new" {
+		t.Fatalf("%d %s", r.Code, r.Body.String())
+	}
+	// A new held store, including its admission failure, must replace the old
+	// reader immediately. No API-level handle, row or response cache survives.
+	replacement := &scopedReadProbe{Store: base, err: errors.New("new generation admission refused")}
+	state.stores["myrig"] = replacement
+	r = exactReadRequest(t, h, state, "/bead/"+row.ID+"/read-exact?store_ref=rig:myrig")
+	if r.Code != 500 || replacement.gets != 1 {
+		t.Fatalf("%d %s", r.Code, r.Body.String())
+	}
+	replacement.err = nil
+	replacement.row = beads.Bead{ID: row.ID, Revision: 99, Status: "open"}
+	r = exactReadRequest(t, h, state, "/bead/"+row.ID+"/read-exact?store_ref=rig:myrig")
+	if r.Code != 200 || replacement.gets != 2 || replacement.closes != 0 {
+		t.Fatalf("%d %s", r.Code, r.Body.String())
+	}
+}
+
+func TestScopedReadHTTPListBothTiersAllStatesWithoutPaginationOrCache(t *testing.T) {
+	state := newFakeState(t)
+	rows := make([]beads.Bead, 1201)
+	for i := range rows {
+		rows[i] = beads.Bead{ID: fmt.Sprintf("fi-%d", i), Status: []string{"open", "in_progress", "closed"}[i%3], Ephemeral: i%2 == 0}
+	}
+	probe := &scopedReadProbe{Store: state.stores["myrig"], rows: rows}
+	state.stores["myrig"] = beads.NewCachingStore(probe, nil)
+	h := newTestCityHandler(t, state)
+	for n := 0; n < 2; n++ {
+		r := exactReadRequest(t, h, state, "/beads/read-exact?store_ref=rig:myrig")
+		var got struct {
+			SchemaVersion string       `json:"schema_version"`
+			OK            bool         `json:"ok"`
+			StoreRef      string       `json:"store_ref"`
+			Beads         []beads.Bead `json:"beads"`
+		}
+		if err := json.Unmarshal(r.Body.Bytes(), &got); err != nil {
+			t.Fatal(err)
+		}
+		if r.Code != 200 || !got.OK || got.SchemaVersion != "1" || got.StoreRef != "rig:myrig" || len(got.Beads) != len(probe.rows) {
+			t.Fatalf("%d count=%d", r.Code, len(got.Beads))
+		}
+		for i, row := range got.Beads {
+			if row.ID != probe.rows[i].ID || row.Status != probe.rows[i].Status || row.Ephemeral != probe.rows[i].Ephemeral {
+				t.Fatalf("changed row %d", i)
+			}
+		}
+		probe.rows = append(probe.rows, beads.Bead{ID: "fi-later", Status: "closed"})
+	}
+	if probe.lists != 2 || probe.closes != 0 {
+		t.Fatal("cached or closed held store")
+	}
+}
+
+func TestScopedReadHTTPRefusesForeignScopesMissingAndUnavailable(t *testing.T) {
+	state := newFakeState(t)
+	probe := &scopedReadProbe{Store: state.stores["myrig"], err: beads.ErrNotFound}
+	state.stores["myrig"] = probe
+	h := newTestCityHandler(t, state)
+	for _, ref := range []string{"city:test-city", "rig:foreign", "rig:../myrig", "remote:myrig", ""} {
+		for _, path := range []string{"/bead/fi-one/read-exact", "/beads/read-exact", "/scoped-read-capability"} {
+			r := exactReadRequest(t, h, state, path+"?store_ref="+ref)
+			if r.Code < 400 || r.Code >= 500 {
+				t.Fatalf("ref=%s status=%d", ref, r.Code)
+			}
+		}
+	}
+	if probe.gets != 0 || probe.lists != 0 {
+		t.Fatal("bad scope reached store")
+	}
+	r := exactReadRequest(t, h, state, "/bead/fi-one/read-exact?store_ref=rig:myrig")
+	if r.Code != 404 {
+		t.Fatalf("%d %s", r.Code, r.Body.String())
+	}
+	probe.err = errors.New("backend unavailable")
+	for _, path := range []string{"/bead/fi-one/read-exact", "/beads/read-exact"} {
+		r = exactReadRequest(t, h, state, path+"?store_ref=rig:myrig")
+		if r.Code != 500 {
+			t.Fatalf("%d %s", r.Code, r.Body.String())
+		}
+	}
+	probe.err = nil
+	for _, row := range []beads.Bead{{ID: "foreign", Revision: 1}, {ID: "fi-one"}} {
+		probe.row = row
+		r = exactReadRequest(t, h, state, "/bead/fi-one/read-exact?store_ref=rig:myrig")
+		if r.Code != 500 {
+			t.Fatal("invalid identity or missing revision accepted")
+		}
+	}
+	state.stores["myrig"] = nil
+	r = exactReadRequest(t, h, state, "/scoped-read-capability?store_ref=rig:myrig")
+	if r.Code != 500 {
+		t.Fatal("missing held store admitted")
+	}
+}
+
+func TestScopedReadHTTPCapabilityIsExactAndDoesNotReadOrClose(t *testing.T) {
+	state := newFakeState(t)
+	probe := &scopedReadProbe{Store: state.stores["myrig"]}
+	state.stores["myrig"] = probe
+	r := exactReadRequest(t, newTestCityHandler(t, state), state, "/scoped-read-capability?store_ref=rig:myrig")
+	var got struct {
+		SchemaVersion string `json:"schema_version"`
+		OK            bool   `json:"ok"`
+		StoreRef      string `json:"store_ref"`
+		Capability    string `json:"capability"`
+		Supported     bool   `json:"supported"`
+	}
+	if err := json.Unmarshal(r.Body.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	if r.Code != 200 || got.SchemaVersion != "1" || !got.OK || got.StoreRef != "rig:myrig" || got.Capability != "exact-live-beads-v1" || !got.Supported {
+		t.Fatalf("%d %+v", r.Code, got)
+	}
+	if probe.gets != 0 || probe.lists != 0 || probe.closes != 0 {
+		t.Fatal("capability changed store lifetime or read domain state")
+	}
+}
