--- /dev/null
+++ b/cmd/gc/testdata/beads-scoped-show.txtar
@@ -0,0 +1,39 @@
+# Exact-store show retains the normal Bead JSON and refuses fallback.
+env GC_SESSION=fake
+env GC_BEADS=file
+env GC_DOLT=skip
+cd $WORK/city
+
+exec gc beads show gc-1 --store-ref=rig:tributary --format=json
+stdout '"title": "exact RIG"'
+! stdout 'CITY collision'
+! stdout '_cache_age_s'
+
+! exec gc beads show gc-2 --store-ref=rig:tributary --format=json
+stderr 'bead not found'
+! stdout 'CITY only'
+
+exec gc beads show gc-1 --store-ref=city:city --format=json
+stdout '"title": "CITY collision"'
+
+! exec gc beads show gc-1 --store-ref= --format=json
+stderr 'invalid --store-ref'
+
+exec gc beads show --help
+stdout '--store-ref'
+
+-- city/city.toml --
+[workspace]
+name = "city"
+[beads]
+provider = "file"
+[[rigs]]
+name = "tributary"
+path = "tributary"
+prefix = "tr"
+-- city/.gc/file-beads-layout --
+scope-local-v1
+-- city/.gc/beads.json --
+{"seq":2,"beads":[{"id":"gc-1","title":"CITY collision","status":"open","issue_type":"task"},{"id":"gc-2","title":"CITY only","status":"open","issue_type":"task"}],"revisions":{"gc-1":1,"gc-2":1},"revisions_sealed":true}
+-- city/tributary/.gc/beads.json --
+{"seq":1,"beads":[{"id":"gc-1","title":"exact RIG","status":"closed","issue_type":"task"}],"revisions":{"gc-1":1},"revisions_sealed":true}
