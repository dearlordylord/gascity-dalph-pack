+// The exact-store projection must not let a CITY collision answer a RIG read.
+func TestRunBeadsShowScopedStoreCollision(t *testing.T) {
+	clearGCEnv(t)
+	configureIsolatedRuntimeEnv(t)
+	cityPath, rigPath := writeMetadataCASScopedFileCity(t)
+	cityStore, err := openScopeLocalFileStore(cityPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rigStore, err := openScopeLocalFileStore(rigPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cityBead, err := cityStore.Create(beads.Bead{Title: "CITY collision", Metadata: beads.StringMap{"source": "city"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rigBead, err := rigStore.Create(beads.Bead{Title: "exact RIG", Metadata: beads.StringMap{"source": "rig"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cityBead.ID != rigBead.ID {
+		t.Fatalf("fixture IDs differ: city=%s rig=%s", cityBead.ID, rigBead.ID)
+	}
+	var stdout, stderr bytes.Buffer
+	code := run([]string{"--city", cityPath, "beads", "show", rigBead.ID, "--store-ref=rig:tributary", "--format=json"}, &stdout, &stderr)
+	if code != 0 {
+		t.Fatalf("exit=%d stderr=%q", code, stderr.String())
+	}
+	var observed beads.Bead
+	if err := json.Unmarshal(stdout.Bytes(), &observed); err != nil {
+		t.Fatalf("invalid Bead JSON: %v", err)
+	}
+	if observed.ID != rigBead.ID || observed.Title != rigBead.Title || observed.Metadata["source"] != "rig" {
+		t.Fatalf("returned the wrong store: %+v", observed)
+	}
+}
+
+func TestRunBeadsShowScopedMissingIDDoesNotFallBack(t *testing.T) {
