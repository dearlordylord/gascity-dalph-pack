new file mode 100644
index 0000000..386795e
--- /dev/null
+++ b/internal/beads/metadata_many.go
@@ -0,0 +1,74 @@
+package beads
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// MetadataManySetter optionally amortizes transport for the same metadata edit
+// on several existing beads. It is NOT atomic: an error may follow partial or
+// complete application. Callers must tolerate replay and cannot infer which
+// rows changed from the error. Implementations must preserve unrelated metadata.
+type MetadataManySetter interface {
+	SetMetadataMany(ids []string, key, value string) error
+}
+
+// SetMetadataMany uses the owning store's optional transport, without unwrapping
+// routing or policy layers. Unsupported stores retain individual writes; every
+// requested marker is attempted even if an earlier one fails.
+func SetMetadataMany(store Store, ids []string, key, value string) error {
+	if len(ids) == 0 {
+		return nil
+	}
+	if setter, ok := store.(MetadataManySetter); ok {
+		return setter.SetMetadataMany(ids, key, value)
+	}
+	var errs []error
+	for _, id := range ids {
+		if err := store.SetMetadata(id, key, value); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	return errors.Join(errs...)
+}
+
+// SetMetadataMany uses bd's public multi-ID update. Unlike ordinary transient
+// writes it makes no retry: a failed command may already have marked some rows.
+// The argument bound is checked BEFORE effects; oversized callers retain their
+// unmarked rows for recovery rather than issuing an unbounded OS argument list.
+func (s *BdStore) SetMetadataMany(ids []string, key, value string) error {
+	if len(ids) == 0 {
+		return nil
+	}
+	const maxArgumentBytes = 64 * 1024
+	if key == "" || strings.ContainsAny(key, "=\x00") || strings.ContainsRune(value, '\x00') {
+		return fmt.Errorf("setting metadata on multiple beads: invalid metadata key or value")
+	}
+	size := len(key) + len(value) + 64
+	for _, id := range ids {
+		if id == "" || strings.TrimSpace(id) != id || strings.HasPrefix(id, "-") || strings.ContainsAny(id, "=\x00") {
+			return fmt.Errorf("setting metadata on multiple beads: invalid bead ID %q", id)
+		}
+		size += len(id) + 1
+	}
+	if size > maxArgumentBytes {
+		return fmt.Errorf("setting metadata on multiple beads: arguments exceed %d bytes", maxArgumentBytes)
+	}
+	for _, id := range ids {
+		noteSessionKeysByID(s.Get, id, map[string]string{key: value})
+	}
+	args := append([]string{"update", "--json"}, ids...)
+	args = append(args, "--set-metadata", key+"="+value)
+	if _, err := s.runner(s.dir, "bd", s.bdTransientWriteArgs(args)...); err != nil {
+		return fmt.Errorf("setting metadata on multiple beads (application may be partial): %w", err)
+	}
+	return nil
+}
+
+// SetMetadataMany preserves the proxied write leaf and its generation bracket.
+func (s *ProxiedStore) SetMetadataMany(ids []string, key, value string) error {
+	return s.withMutation("set-metadata-many", func(leaf Store) error {
+		return SetMetadataMany(leaf, ids, key, value)
+	})
+}
diff --git a/internal/beads/metadata_many_test.go b/internal/beads/metadata_many_test.go
new file mode 100644
