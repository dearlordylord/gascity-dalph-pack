+// Readiness offers only the existing proxied read adapter. All other backends
+// keep the raw control store; no ordinary native write backend is supplied.
+func openControlReadStoreAtForCity(storePath, cityPath string, cfg *config.City) (beads.Store, error) {
+	scopeRoot := resolveStoreScopeRoot(cityPath, storePath)
+	provider := rawBeadsProviderForScope(scopeRoot, cityPath)
+	if provider == "file" || strings.HasPrefix(provider, "exec:") {
+		return openControlStoreAtForCity(storePath, cityPath, cfg)
+	}
+	if cfg == nil {
+		loaded, err := loadCityConfigForStoreOpen(cityPath, provider, nil)
+		if err != nil {
+			return nil, err
+		}
+		cfg = loaded
+	}
+	openBd := func() (beads.Store, error) {
+		if samePath(scopeRoot, cityPath) {
+			return controlBdStoreForCity(scopeRoot, cityPath, cfg), nil
+		}
+		return controlBdStoreForRig(scopeRoot, cityPath, cfg), nil
+	}
+	opts := controlBdStoreFactoryOptions(scopeRoot, cityPath, provider, cfg, openBd)
+	opts.NativeTransport = resolvedNativeTransportMode(cfg)
+	opts.OpenProxiedStore = proxiedNativeStoreOpenerForScope(cityPath, scopeRoot, cfg, openBd)
+	result, err := openStoreFactoryForCity(context.Background(), opts)
 	if err != nil {
 		return nil, err
 	}
