+// A readiness scan owns a short-lived read handle. Control mutations continue
+// to use their existing raw BdStore, rather than inheriting this read adapter.
+func TestControlReadySourcesOfferProxiedReaderAndCloseIt(t *testing.T) {
+	t.Setenv("GC_HOME", t.TempDir())
+	t.Setenv("GC_BEADS", "bd")
+	bin := t.TempDir()
+	stub := "#!/bin/sh\ncase \"$1\" in\nready) printf '%s\\n' '[{\"id\":\"fixture-ready\",\"status\":\"open\",\"issue_type\":\"task\"}]';;\n*) printf '%s\\n' 'Usage: bd [flags]' '  --if-revision int';;\nesac\n"
+	if err := os.WriteFile(filepath.Join(bin, "bd"), []byte(stub), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", bin+string(os.PathListSeparator)+os.Getenv("PATH"))
+	city := t.TempDir()
+	cfg, err := config.Parse([]byte("[workspace]\nname = \"readiness\"\n[beads]\nprovider = \"bd\"\nnative_transport = \"off\"\nconditional_writes = \"require\"\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(city, "city.toml"), []byte("[workspace]\nname = \"readiness\"\n[beads]\nprovider = \"bd\"\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	reader := newCloseCountingStore(t, true)
+	var captured beads.StoreOpenOptions
+	previous := openStoreFactoryForCity
+	openStoreFactoryForCity = func(_ context.Context, opts beads.StoreOpenOptions) (beads.StoreOpenResult, error) {
+		captured = opts
+		return beads.StoreOpenResult{Store: reader}, nil
+	}
+	t.Cleanup(func() { openStoreFactoryForCity = previous })
+	ready, opened, err := controlReadyLegsReady(city, city, cfg)
+	if err != nil || !opened || len(ready) != 1 {
+		t.Fatalf("readiness = %v, %t, %v; want one ready bead", ready, opened, err)
+	}
+	if captured.OpenProxiedStore == nil || captured.OpenBdStore == nil || captured.LongLived {
+		t.Fatal("readiness must offer the existing short-lived proxied reader and Bd fallback")
+	}
+	if captured.OpenNativeStore != nil || captured.PreflightChecker.BDContext != nil {
+		t.Fatal("readiness must not enable the ordinary direct-native backend")
+	}
+	if captured.NativeTransport != beads.NativeTransportOff || captured.ConditionalWrites != gate.Require {
+		t.Fatalf("readiness lost operator policy: native=%q conditional=%q", captured.NativeTransport, captured.ConditionalWrites)
+	}
+	if reader.closes() != 1 {
+		t.Fatalf("readiness reader closed %d times, want once", reader.closes())
+	}
+}
