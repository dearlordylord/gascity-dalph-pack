+// This candidate proof requires the same revision-capable bd as the linked
+// library. It owns one rig proxy; no supervisor or provider is launched.
+func TestControlReadyMatchedProxyDifferential(t *testing.T) {
+	if _, err := exec.LookPath("bd"); err != nil {
+		t.Fatal("matched bd is required for the proxied readiness proof")
+	}
+	root, err := os.MkdirTemp("", "gc-readiness-proxied-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("retained readiness proof: %s", root)
+	for _, kv := range os.Environ() {
+		key, _, _ := strings.Cut(kv, "=")
+		if strings.HasPrefix(key, "GC_") || strings.HasPrefix(key, "BEADS_") || strings.HasPrefix(key, "DOLT_") {
+			t.Setenv(key, "")
+		}
+	}
+	city, rig := filepath.Join(root, "city"), filepath.Join(root, "rig")
+	for _, dir := range []string{city, rig, filepath.Join(root, "home")} {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Setenv("HOME", filepath.Join(root, "home"))
+	t.Setenv("GC_HOME", filepath.Join(root, "home", "gc"))
+	t.Setenv("GC_BEADS", "bd")
+	t.Setenv("BEADS_DIR", filepath.Join(rig, ".beads"))
+	t.Setenv("BEADS_TEST_MODE", "0")
+	t.Setenv("BD_DISABLE_METRICS", "1")
+	t.Setenv("DOLT_ROOT_PATH", filepath.Join(root, "dolt-home"))
+	trace := filepath.Join(root, "bd-trace.jsonl")
+	t.Setenv("GC_BD_TRACE_JSON", trace)
+	runner := func(dir, name string, args ...string) ([]byte, error) {
+		ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+		defer cancel()
+		cmd := exec.CommandContext(ctx, name, args...)
+		cmd.Dir = dir
+		return cmd.CombinedOutput()
+	}
+	t.Cleanup(func() {
+		if out, err := runner(rig, "bd", "dolt", "stop"); err != nil {
+			t.Errorf("owned proxy stop failed; retaining %s: %v: %s", root, err, out)
+			return
+		}
+		if err := os.RemoveAll(root); err != nil {
+			t.Errorf("remove stopped proof scope: %v", err)
+		}
+	})
+	for _, args := range [][]string{{"git", "init"}, {"bd", "init", "--proxied-server", "-p", "rd", "--skip-hooks", "--skip-agents"}} {
+		if out, err := runner(rig, args[0], args[1:]...); err != nil {
+			t.Fatalf("fixture %v: %v: %s", args, err, out)
+		}
+	}
+	source := fmt.Sprintf("[workspace]\nname = \"readiness-proof\"\n[beads]\nprovider = \"bd\"\nconditional_writes = \"require\"\n[[rigs]]\nname = \"fixture\"\nprefix = \"rd\"\npath = %q\n", rig)
+	if err := os.WriteFile(filepath.Join(city, "city.toml"), []byte(source), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := config.Parse([]byte(source))
+	if err != nil {
+		t.Fatal(err)
+	}
+	writer := beads.NewBdStoreWithPrefix(rig, runner, "rd")
+	create := func(title string, ephemeral bool) beads.Bead {
+		b, err := writer.Create(beads.Bead{Title: title, Type: "task", Ephemeral: ephemeral})
+		if err != nil {
+			t.Fatalf("create %s: %v", title, err)
+		}
+		return b
+	}
+	ready := create("ready", false)
+	wisp := create("ephemeral ready", true)
+	blocker, blocked, closed := create("blocker", false), create("blocked", false), create("closed", false)
+	if err := writer.DepAdd(blocked.ID, blocker.ID, "blocks"); err != nil {
+		t.Fatal(err)
+	}
+	if err := writer.Close(closed.ID); err != nil {
+		t.Fatal(err)
+	}
+	head := func() string {
+		out, err := runner(rig, "bd", "sql", "--json", "SELECT DOLT_HASHOF('HEAD') AS head")
+		if err != nil {
+			t.Fatalf("read HEAD: %v: %s", err, out)
+		}
+		return strings.TrimSpace(string(out))
+	}
+	before := head()
+	var diagnostic beads.BeadsDiagnostic
+	var openedStore *readinessObservedStore
+	previous := openStoreFactoryForCity
+	openStoreFactoryForCity = func(ctx context.Context, opts beads.StoreOpenOptions) (beads.StoreOpenResult, error) {
+		result, err := previous(ctx, opts)
+		diagnostic = result.Diagnostic
+		if err == nil {
+			openedStore = &readinessObservedStore{Store: result.Store}
+			result.Store = openedStore
+		}
+		return result, err
+	}
+	t.Cleanup(func() { openStoreFactoryForCity = previous })
+	scan := func(native string) []string {
+		t.Setenv("GC_BEADS_PROXIED_NATIVE", native)
+		rows, opened, err := controlReadyLegsReady(rig, city, cfg)
+		if err != nil || !opened {
+			t.Fatalf("scan native=%s: opened=%t err=%v", native, opened, err)
+		}
+		ids := make([]string, len(rows))
+		for i, row := range rows {
+			ids[i] = row.ID
+		}
+		slices.Sort(ids)
+		return ids
+	}
+	expected := []string{ready.ID, wisp.ID, blocker.ID}
+	slices.Sort(expected)
+	if ids := scan("0"); !slices.Equal(ids, expected) || diagnostic.Store != "BdStore" {
+		t.Fatalf("Bd readiness = %v, %s; want %v", ids, diagnostic.Store, expected)
+	}
+	readyForks := func() int {
+		data, err := os.ReadFile(trace)
+		if err != nil {
+			t.Fatalf("read owned bd trace: %v", err)
+		}
+		return strings.Count(string(data), `"args":["ready"`)
+	}
+	fallbackForks := readyForks()
+	if fallbackForks != 1 {
+		t.Fatalf("Bd scan ready forks = %d, want one", fallbackForks)
+	}
+	if ids := scan("1"); !slices.Equal(ids, expected) || diagnostic.Store != "NativeDoltStore" {
+		t.Fatalf("native readiness = %v, %s, %+v; want %v", ids, diagnostic.Store, diagnostic.Proxied, expected)
+	}
+	if openedStore.closes != 1 || openedStore.closeErr != nil {
+		t.Fatalf("native handle closure = %d, %v; want once successfully", openedStore.closes, openedStore.closeErr)
+	}
+	if readyForks() != fallbackForks {
+		t.Fatal("admitted native readiness still forked bd ready")
+	}
+	cfg, err = config.Parse([]byte(strings.Replace(source, "provider = \"bd\"", "provider = \"bd\"\nnative_transport = \"off\"", 1)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ids := scan("1"); !slices.Equal(ids, expected) || diagnostic.Store != "BdStore" || readyForks() != fallbackForks+1 {
+		t.Fatalf("operator-off readiness = %v, %s; want Bd fallback with the same frontier", ids, diagnostic.Store)
+	}
+	if after := head(); after != before {
+		t.Fatalf("readiness changed HEAD: before=%s after=%s", before, after)
+	}
+	t.Log("matched native/Bd ready, blocked, closed and ephemeral rows agree; owned native handle closed; HEAD unchanged")
+}
