+		{name: "unsafe id", id: "../tr-1", ref: "rig:tributary", format: "json"},
+		{name: "invalid format", id: "tr-1", ref: "rig:tributary", format: "yaml"},
+		{name: "remote target", id: "tr-1", ref: "rig:tributary", format: "json", remote: true},
