diff --git a/cmd/gc/cmd_beads_scoped_show.go b/cmd/gc/cmd_beads_scoped_show.go
new file mode 100644
index 0000000..0cef2c4
--- /dev/null
+++ b/cmd/gc/cmd_beads_scoped_show.go
@@ -0,0 +1,84 @@
+package main
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+
+	"github.com/gastownhall/gascity/internal/beads"
+)
+
+var (
+	openBeadsScopedShowStore  = openAuthoritativeStoreAtForCity
+	closeBeadsScopedShowStore = closeBeadStoreHandle
+)
+
+// cmdBeadsScopedShow projects an exact authoritative Store.Get through the
+// existing Bead formatter. The caller owns only the handle it opened; class
+// binding handles remain owned by the CLI's storage routing composition.
+func cmdBeadsScopedShow(id, storeRef, format string, stdout, stderr io.Writer) int {
+	_, remote, cityPath, err := resolveReadTarget()
+	if err != nil {
+		return failBeadsScopedShow(stderr, err)
+	}
+	if !validMetadataCASToken(id, metadataCASMaxBeadIDBytes) {
+		return failBeadsScopedShow(stderr, errors.New("invalid bead id"))
+	}
+	if format != "json" && format != "text" {
+		return failBeadsScopedShow(stderr, fmt.Errorf("invalid --format %q: expected text or json", format))
+	}
+	if _, _, err := parseBeadsMetadataCASStoreRef(storeRef); err != nil {
+		return failBeadsScopedShow(stderr, err)
+	}
+	if remote {
+		return failBeadsScopedShow(stderr, errors.New("exact store reads require a local city"))
+	}
+	cfg, err := loadCityConfig(cityPath, configWarnWriter(format == "json", stderr))
+	if err != nil {
+		return failBeadsScopedShow(stderr, err)
+	}
+	scopeRoot, canonicalRef, err := resolveBeadsMetadataCASStore(cfg, cityPath, storeRef)
+	if err != nil {
+		return failBeadsScopedShow(stderr, err)
+	}
+	if scopeIsCity(cityPath, scopeRoot) {
+		owner, relocated, err := cliByIDBindingOwner(cityPath, id)
+		if err != nil {
+			return failBeadsScopedShow(stderr, err)
+		}
+		if relocated {
+			return failBeadsScopedShow(stderr, fmt.Errorf("exact store %s cannot serve migrated bead %s owned by %s", canonicalRef, id, owner.Ref))
+		}
+	}
+	store, err := openBeadsScopedShowStore(scopeRoot, cityPath)
+	if err != nil {
+		return failBeadsScopedShow(stderr, err)
+	}
+	bead, readErr := store.Get(id)
+	if err := errors.Join(readErr, closeBeadsScopedShowStore(store)); err != nil {
+		return failBeadsScopedShow(stderr, err)
+	}
+	if bead.ID != id {
+		return failBeadsScopedShow(stderr, errors.New("exact store returned another bead"))
+	}
+	return renderBeadsScopedShow(bead, format, stdout, stderr)
+}
+
+func renderBeadsScopedShow(bead beads.Bead, format string, stdout, stderr io.Writer) int {
+	var rendered bytes.Buffer
+	if format == "json" {
+		writeBeadJSON(bead, &rendered)
+	} else {
+		writeBeadDetail(bead, &rendered)
+	}
+	if _, err := io.Copy(stdout, &rendered); err != nil {
+		return failBeadsScopedShow(stderr, err)
+	}
+	return 0
+}
+
+func failBeadsScopedShow(stderr io.Writer, err error) int {
+	fmt.Fprintf(stderr, "gc beads show: %v\n", err) //nolint:errcheck // best-effort stderr
+	return 1
+}
