@@ -0,0 +1,108 @@
+package beads
+
+import (
+	"errors"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestBdStoreMetadataManyOneCommandAndNoRetry(t *testing.T) {
+	for _, writeErr := range []error{nil, errors.New("connection reset by peer after partial update")} {
+		calls := 0
+		store := NewBdStore("/owned-rig", func(dir, name string, args ...string) ([]byte, error) {
+			calls++
+			want := []string{"update", "--json", "fi-one", "fi-wisp-two", "--set-metadata", "gc.step_defined_emitted=ack-time"}
+			if dir != "/owned-rig" || name != "bd" || !reflect.DeepEqual(args, want) {
+				t.Fatalf("command %s %s %v", dir, name, args)
+			}
+			return []byte(`[{"id":"fi-one"}]`), writeErr
+		})
+		err := SetMetadataMany(store, []string{"fi-one", "fi-wisp-two"}, "gc.step_defined_emitted", "ack-time")
+		if !errors.Is(err, writeErr) || calls != 1 {
+			t.Fatalf("err=%v calls=%d", err, calls)
+		}
+	}
+}
+
+func TestBdStoreMetadataManyRefusesInvalidOrOversizedBeforeEffects(t *testing.T) {
+	store := NewBdStore("/owned-rig", func(string, string, ...string) ([]byte, error) { t.Fatal("unexpected command"); return nil, nil })
+	for _, ids := range [][]string{{""}, {"fi-one", "--claim"}, {"fi-one", "bad=value"}, {strings.Repeat("x", 64*1024)}} {
+		if err := SetMetadataMany(store, ids, "marker", "1"); err == nil {
+			t.Fatalf("accepted %v", ids)
+		}
+	}
+	if err := SetMetadataMany(store, nil, "marker", "1"); err != nil {
+		t.Fatal(err)
+	}
+}
+
+type metadataManyFallback struct {
+	Store
+	seen []string
+}
+
+func (s *metadataManyFallback) SetMetadata(id, key, value string) error {
+	s.seen = append(s.seen, id)
+	if id == "missing" {
+		return ErrNotFound
+	}
+	return s.Store.SetMetadata(id, key, value)
+}
+
+func TestMetadataManyFallbackContinuesAfterFailureAndPreservesOtherKeys(t *testing.T) {
+	base := NewMemStore()
+	row, err := base.Create(Bead{Title: "task", Metadata: map[string]string{"retained": "exact"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	store := &metadataManyFallback{Store: base}
+	if err := SetMetadataMany(store, []string{"missing", row.ID}, "marker", "1"); !errors.Is(err, ErrNotFound) {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(store.seen, []string{"missing", row.ID}) {
+		t.Fatal(store.seen)
+	}
+	fresh, _ := base.Get(row.ID)
+	if fresh.Metadata["retained"] != "exact" || fresh.Metadata["marker"] != "1" {
+		t.Fatal(fresh.Metadata)
+	}
+}
+
+func TestProxiedStoreMetadataManyUsesWriteLeaf(t *testing.T) {
+	store, _, leaf := newSplitFixture(t)
+	row, err := store.Create(Bead{Title: "task", Metadata: map[string]string{"retained": "exact"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := SetMetadataMany(store, []string{row.ID}, "marker", "1"); err != nil {
+		t.Fatal(err)
+	}
+	fresh, err := leaf.Get(row.ID)
+	if err != nil || fresh.Metadata["retained"] != "exact" || fresh.Metadata["marker"] != "1" {
+		t.Fatalf("row=%+v err=%v", fresh, err)
+	}
+}
+
+func TestProxiedStoreMetadataManyPreservesBulkCommandFailure(t *testing.T) {
+	native := newNativeDoltStoreForTest(newNativeDoltMemStorage(), WithProxiedReadOnly())
+	calls := 0
+	lost := errors.New("response lost after commit")
+	leaf := NewBdStore("/owned-rig", func(_ string, _ string, args ...string) ([]byte, error) {
+		calls++
+		if !reflect.DeepEqual(args, []string{"update", "--json", "fi-a", "fi-b", "--set-metadata", "marker=1"}) {
+			t.Fatal(args)
+		}
+		return nil, lost
+	})
+	store, err := NewProxiedStore(native, leaf, PinForTest("/scope", "", "beads"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := SetMetadataMany(store, []string{"fi-a", "fi-b"}, "marker", "1"); !errors.Is(err, lost) {
+		t.Fatal(err)
+	}
+	if calls != 1 {
+		t.Fatalf("calls=%d, want one public bulk command", calls)
+	}
+}
