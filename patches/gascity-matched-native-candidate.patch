+			clearGCEnv(t)
+			configureIsolatedRuntimeEnv(t)
+			cityPath := writeMetadataCASTestCity(t)
+			opens := 0
+			installScopedShowStore(t, func(string, string) (beads.Store, error) { opens++; return beads.NewMemStore(), nil })
+			args := []string{"--city", cityPath}
+			if input.remote {
