+// closedStepGraphStore resolves the root's logical scope through residency using
+// controller-owned handles. Malformed/unserved scopes and failed probes refuse
+// without reading a same-id shadow. Legacy rows keep the graph-class route.
+func (cs *controllerState) closedStepGraphStore(step beads.Bead, owner beads.Store, ownerRef string) (beads.GraphStore, error) {
+	ref := strings.TrimSpace(step.Metadata[beadmeta.RootStoreRefMetadataKey])
+	if ref == "" {
+		return cs.GraphBeadStore(), nil
+	}
+	rig, valid := storeref.ScopeRigContext(ref)
+	if !valid {
+		return beads.GraphStore{}, fmt.Errorf("graph root has invalid store ref %q", ref)
+	}
+
+	cs.mu.RLock()
+	cityWork := cs.cityBeadStore
+	name := cs.cityName
+	if name == "" && cs.cfg != nil {
+		name = loadedCityName(cs.cfg, cs.cityPath)
+	}
+	bindings, refusal := residencyBindingsFromRoutes(cs.storageRoutes)
+	cs.mu.RUnlock()
+	var work beads.Store
+	if rig != "" {
+		if cs.rigSuspended(rig) {
+			return beads.GraphStore{}, fmt.Errorf("graph root scope %q is suspended", ref)
+		}
+		if ref == ownerRef {
+			work = owner
+		} else {
+			work = cs.BeadStore(rig)
+		}
+	} else if ref == "city:"+name && name != "" {
+		work = cityWork
+	}
+	if work != nil {
+		rootID := strings.TrimSpace(step.Metadata[beadmeta.RootBeadIDMetadataKey])
+		if rootID == "" {
+			rootID = step.ParentID
+		}
+		if rootID == "" {
+			return cs.GraphBeadStore(), nil
+		}
+		topology := assembleResidencyTopology(nil, work, nil, bindings, refusal)
+		resolved, err := byIDOwnerForTopology(topology, rootID, work)
+		if err != nil {
+			return beads.GraphStore{}, err
+		}
+		return beads.GraphStore{Store: resolved.Store}, nil
+	}
+	if refusal != nil {
+		return beads.GraphStore{}, refusal
+	}
+	for _, binding := range bindings {
+		if string(binding.Leg.Ref) == ref {
+			return beads.GraphStore{Store: binding.Leg.Store}, nil
+		}
+	}
+	return beads.GraphStore{}, fmt.Errorf("graph root store %q is not served by this city", ref)
+}
