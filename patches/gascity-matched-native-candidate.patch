+// RecoverableAttachControls discovers a committed attach that blocks its owner while every child is
+// still held. The owner is recovery work, despite not being ordinary Ready.
+// Resolve it in the same graph leg; never guess another store for a missing ID.
+func RecoverableAttachControls(store beads.Store, tier beads.TierMode) ([]beads.Bead, error) {
+	var roots []beads.Bead
+	for _, marker := range []string{"true", "activating"} {
+		matches, err := store.List(beads.ListQuery{Status: "open", Metadata: map[string]string{
+			beadmeta.AttachFencePendingMetadataKey: marker,
+		}, TierMode: tier})
+		if err != nil {
+			return nil, err
+		}
+		roots = append(roots, matches...)
+	}
+	owners := make(map[string]beads.Bead)
+	for _, root := range roots {
+		pending := root.Metadata[beadmeta.AttachFencePendingMetadataKey]
+		if pending != "true" && pending != "activating" {
+			continue
+		}
+		number := beadmeta.RetryAttemptNumber(root.Metadata)
+		key := root.Metadata[beadmeta.IdempotencyKeyMetadataKey]
+		suffix := fmt.Sprintf(":attempt:%d", number)
+		if number < 2 || !strings.HasSuffix(key, suffix) {
+			continue
+		}
+		id := strings.TrimSuffix(key, suffix)
+		if id == "" {
+			continue
+		}
+		control, err := store.Get(id)
+		if err != nil {
+			return nil, err
+		}
+		kind := control.Metadata[beadmeta.KindMetadataKey]
+		if control.Status != "open" || control.Type == "gate" ||
+			(kind != beadmeta.KindRalph && kind != beadmeta.KindRetry) ||
+			(control.Metadata[beadmeta.ControlEpochMetadataKey] != strconv.Itoa(number) &&
+				!(pending == "true" && control.Metadata[beadmeta.ControlEpochMetadataKey] == strconv.Itoa(number-1))) ||
+			root.Metadata[beadmeta.RootBeadIDMetadataKey] != beadmeta.ResolveRunID(control.Metadata, control.ID, "") ||
+			root.Metadata[beadmeta.RootStoreRefMetadataKey] != control.Metadata[beadmeta.RootStoreRefMetadataKey] {
+			continue
+		}
+		owners[id] = control
+	}
+	result := make([]beads.Bead, 0, len(owners))
+	for _, owner := range owners {
+		result = append(result, owner)
+	}
+	beads.SortBeadsReadyOrder(result)
+	return result, nil
+}
