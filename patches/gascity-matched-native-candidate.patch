+type lostFencedGraphResponseStore struct {
+	beads.Store
+	applier              beads.GraphApplyStore
+	calls                int
+	loseResponse         bool
+	failEdge             bool
+	failFenceObservation bool
+	failActivation       bool
+}
+
+func (s *lostFencedGraphResponseStore) ConditionalWritesResolveTarget() beads.Store { return s.Store }
+
+func (s *lostFencedGraphResponseStore) ApplyGraphPlan(ctx context.Context, plan *beads.GraphApplyPlan) (*beads.GraphApplyResult, error) {
+	s.calls++
+	result, err := s.applier.ApplyGraphPlan(ctx, plan)
+	if err != nil {
+		return nil, err
+	}
+	for _, id := range result.IDs {
+		row, err := s.Store.Get(id)
+		if err != nil {
+			return nil, err
+		}
+		if !beads.IsReadyExcludedBead(row) || row.Assignee != "" || row.Metadata[beadmeta.RoutedToMetadataKey] != "" {
+			return nil, fmt.Errorf("pending graph contains runnable row %s", id)
+		}
+	}
+	if s.loseResponse {
+		s.loseResponse = false
+		return nil, errors.New("bd create --graph: connection reset by peer after commit")
+	}
+	return result, nil
+}
+
+func (s *lostFencedGraphResponseStore) DepAdd(from, to, kind string) error {
+	if s.failEdge && kind == "blocks" {
+		s.failEdge = false
+		return errors.New("blocking edge temporarily unavailable")
+	}
+	return s.Store.DepAdd(from, to, kind)
+}
+
+func (s *lostFencedGraphResponseStore) Get(id string) (beads.Bead, error) {
+	row, err := s.Store.Get(id)
+	if err == nil && s.failFenceObservation && row.Metadata["gc.control_epoch"] == "2" {
+		s.failFenceObservation = false
+		return beads.Bead{}, errors.New("fresh epoch observation unavailable")
+	}
+	return row, err
+}
+
+func (s *lostFencedGraphResponseStore) Update(id string, opts beads.UpdateOpts) error {
+	if s.failActivation && opts.Type != nil {
+		s.failActivation = false
+		return errors.New("activation interrupted")
+	}
+	return s.Store.Update(id, opts)
+}
+
+func TestAttachFencedGraphLostResponseRecoversOneSurvivor(t *testing.T) {
+	prev := IsGraphApplyEnabled()
+	SetGraphApplyEnabled(true)
+	t.Cleanup(func() { SetGraphApplyEnabled(prev) })
+	base, err := beads.OpenSQLiteStore(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = base.(interface{ CloseStore() error }).CloseStore() })
+	if err := beads.StampOpenedStore(base, "SQLiteStore", gate.Require, nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	applier, ok := beads.GraphApplyFor(base)
+	if !ok {
+		t.Fatal("missing graph capability")
+	}
+	store := &lostFencedGraphResponseStore{Store: base, applier: applier, loseResponse: true}
+	root := setupWorkflow(t, store)
+	control := setupWorkflowChild(t, store, root.ID, "Control")
+	if err := store.SetMetadata(control.ID, "gc.control_epoch", "1"); err != nil {
+		t.Fatal(err)
+	}
+	opts := AttachOptions{IdempotencyKey: control.ID + ":attempt:2", ExpectedEpoch: 1}
+	if _, err := Attach(t.Context(), store, makeWorkflowRecipe("attempt", "run"), control.ID, opts); err == nil {
+		t.Fatal("lost response reported success")
+	}
+	if store.calls != 1 {
+		t.Fatalf("ambiguous apply retried %d times", store.calls)
+	}
+	pending, err := store.List(beads.ListQuery{Metadata: map[string]string{beadmeta.IdempotencyKeyMetadataKey: opts.IdempotencyKey}})
+	if err != nil || len(pending) != 1 {
+		t.Fatalf("pending roots = %v, %v", pending, err)
+	}
+	if pending[0].Metadata[beadmeta.AttachFencePendingMetadataKey] != "true" {
+		t.Fatal("uncertain graph activated")
+	}
+	store.failEdge = true
+	if _, err := Attach(t.Context(), store, makeWorkflowRecipe("attempt", "run"), control.ID, opts); err == nil {
+		t.Fatal("missing edge reported successful recovery")
+	}
+	stillPending, err := store.Get(pending[0].ID)
+	if err != nil || stillPending.Metadata[beadmeta.AttachFencePendingMetadataKey] != "true" {
+		t.Fatalf("failed edge activated graph: %+v, %v", stillPending, err)
+	}
+	unchanged, err := store.Get(control.ID)
+	if err != nil || unchanged.Metadata["gc.control_epoch"] != "1" {
+		t.Fatalf("failed edge consumed epoch: %+v, %v", unchanged, err)
+	}
+	store.failFenceObservation = true
+	if _, err := Attach(t.Context(), store, makeWorkflowRecipe("attempt", "run"), control.ID, opts); err == nil {
+		t.Fatal("unobserved epoch reported successful recovery")
+	}
+	stillPending, err = store.Get(pending[0].ID)
+	if err != nil || stillPending.Metadata[beadmeta.AttachFencePendingMetadataKey] != "true" {
+		t.Fatalf("unobserved epoch activated graph: %+v, %v", stillPending, err)
+	}
+	store.failActivation = true
+	if _, err := Attach(t.Context(), store, makeWorkflowRecipe("attempt", "run"), control.ID, opts); err == nil {
+		t.Fatal("interrupted activation reported successful recovery")
+	}
+	recovered, err := Attach(t.Context(), store, makeWorkflowRecipe("attempt", "run"), control.ID, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if recovered.RootID != pending[0].ID || !recovered.Duplicate || store.calls != 1 {
+		t.Fatalf("recovery minted another graph: %+v, calls=%d", recovered, store.calls)
+	}
+	activated, err := store.Get(recovered.RootID)
+	if err != nil || activated.Metadata[beadmeta.AttachFencePendingMetadataKey] != "" {
+		t.Fatalf("winner not activated: %+v, %v", activated, err)
+	}
+	current, err := store.Get(control.ID)
+	if err != nil || current.Metadata["gc.control_epoch"] != "2" {
+		t.Fatalf("epoch advanced incorrectly: %+v, %v", current, err)
+	}
+	for step, id := range recovered.IDMapping {
+		row, err := store.Get(id)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if row.Type == "gate" || row.Metadata[DeferredTypeMetadataKey] != "" {
+			t.Fatalf("recovery left executable step deferred: %s %+v", step, row)
+		}
+		if row.Metadata[beadmeta.RootBeadIDMetadataKey] != root.ID {
+			t.Fatalf("lost parent workflow: %+v", row)
+		}
+	}
+	assertBlockingDependency(t, store, control.ID, recovered.RootID)
+}
