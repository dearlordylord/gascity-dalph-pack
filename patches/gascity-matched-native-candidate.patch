+func TestProcessRalphControlHardSubjectFailureDoesNotIterate(t *testing.T) {
+	t.Parallel()
+	store, control := newUnlaunchableCheckRalphControl(t, "not-needed.sh")
+	if err := store.SetMetadata(control.ID, beadmeta.MaxAttemptsMetadataKey, "4"); err != nil {
+		t.Fatal(err)
+	}
+	rows, err := store.List(beads.ListQuery{AllowScan: true, IncludeClosed: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, row := range rows {
+		if row.Metadata[beadmeta.KindMetadataKey] == beadmeta.KindScope {
+			if err := store.SetMetadataBatch(row.ID, map[string]string{
+				beadmeta.OutcomeMetadataKey:       beadmeta.OutcomeFail,
+				beadmeta.FailureClassMetadataKey:  beadmeta.FailureClassHard,
+				beadmeta.FailureReasonMetadataKey: "review transport retries exhausted",
+			}); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	before := countAllBeads(t, store)
+	result, err := ProcessControl(store, mustGet(t, store, control.ID), ProcessOptions{})
+	if err != nil {
+		t.Fatalf("ProcessControl: %v", err)
+	}
+	got := mustGet(t, store, control.ID)
+	if result.Action != "hard-fail" || got.Status != "closed" || got.Metadata[beadmeta.FinalDispositionMetadataKey] != beadmeta.DispositionHardFail {
+		t.Fatalf("result=%+v control=%+v, want closed hard failure", result, got)
+	}
+	if got.Metadata[beadmeta.FailedAttemptMetadataKey] != "1" || countAllBeads(t, store) != before {
+		t.Fatalf("hard failure must retain iteration one without spawning a successor: %+v", got)
+	}
+}
+
+// Exit 75 is infrastructure blindness, not a semantic rejection. Reconciliation
+// must retry the same completed iteration and spend only the infrastructure budget.
+func TestProcessRalphControlInfraGateDoesNotBurnIteration(t *testing.T) {
+	t.Parallel()
+	city := t.TempDir()
+	path := filepath.Join(city, "infra.sh")
+	writeExecutableScript(t, path, "#!/bin/sh\nexit 75\n")
+	store, control := newUnlaunchableCheckRalphControl(t, "infra.sh")
+	before := countAllBeads(t, store)
+	_, err := ProcessControl(store, control, ProcessOptions{CityPath: city})
+	if !errors.Is(err, ErrControlPending) {
+		t.Fatalf("ProcessControl = %v, want attempt-free pending", err)
+	}
+	got := mustGet(t, store, control.ID)
+	if got.Status == "closed" || got.Metadata[beadmeta.CheckInfraRetryMetadataKey] != "1" || countAllBeads(t, store) != before {
+		t.Fatalf("infrastructure retry must preserve the same iteration: %+v", got)
+	}
+	writeExecutableScript(t, path, "#!/bin/sh\nexit 0\n")
+	result, err := ProcessControl(store, got, ProcessOptions{CityPath: city})
+	if err != nil || result.Action != "pass" || countAllBeads(t, store) != before {
+		t.Fatalf("recovered gate = %+v, %v; want same-iteration pass", result, err)
+	}
