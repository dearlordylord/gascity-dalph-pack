+func assertBlockingDependency(t *testing.T, store beads.Store, from, to string) {
+	t.Helper()
+	deps, err := store.DepList(from, "down")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, dep := range deps {
+		if dep.DependsOnID == to && dep.Type == "blocks" {
+			return
+		}
+	}
+	t.Fatalf("missing blocking edge %s -> %s", from, to)
+}
