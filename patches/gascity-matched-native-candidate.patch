+// A rig-scoped cook stores the root and its steps together. A controller close
+// already knows this owning scope; it must not ask the city store for that root.
+type rigCompletionRootReadCounter struct {
+	beads.Store
+	root    string
+	reads   int
+	failure error
+}
+
+func (s *rigCompletionRootReadCounter) Get(id string) (beads.Bead, error) {
+	if id == s.root {
+		s.reads++
+		if s.failure != nil {
+			return beads.Bead{}, s.failure
+		}
+	}
+	return s.Store.Get(id)
+}
+
+func TestControllerCommittedCloseKeepsCoResidentRigGraphAuthority(t *testing.T) {
+	previous := beadCloseAutocloseDispatch
+	beadCloseAutocloseDispatch = func(fn func()) { fn() }
+	t.Cleanup(func() { beadCloseAutocloseDispatch = previous })
+	rig := beads.NewMemStore()
+	rig.HonorExplicitIDs = true
+	root, err := rig.Create(beads.Bead{ID: "fi-root", Type: "molecule", Metadata: map[string]string{
+		"gc.kind": "workflow", "gc.formula_contract": "graph.v2", "gc.root_store_ref": "rig:fixture",
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	step, err := rig.Create(beads.Bead{ID: "fi-step", Type: "step", ParentID: root.ID, Metadata: map[string]string{
+		"gc.root_bead_id": root.ID, "gc.root_store_ref": "rig:fixture", "gc.step_id": "build", "gc.session_id": "na-wisp-worker",
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := rig.Close(step.ID); err != nil {
+		t.Fatal(err)
+	}
+	step, err = rig.Get(step.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	payload, err := beads.EncodeBeadEventPayload(step)
+	if err != nil {
+		t.Fatal(err)
+	}
+	city := &rigCompletionRootReadCounter{Store: beads.NewMemStore(), root: root.ID}
+	journal := events.NewFake()
+	cs := &controllerState{cityBeadStore: city, beadStores: map[string]beads.Store{"fixture": rig}, eventProv: journal}
+	event := events.Event{Type: events.BeadClosed, Subject: step.ID, Actor: "bd-hook", Payload: payload}
+	cs.applyCommittedClose(event, rig, "rig:fixture")
+	cs.applyCommittedClose(event, rig, "rig:fixture")
+	completed, err := journal.List(events.Filter{Type: events.ExecutionStepCompleted, Subject: step.ID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(completed) != 1 {
+		t.Fatalf("completed facts = %d, want one for retained rig root", len(completed))
+	}
+	current, err := rig.Get(root.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if current.Status != "closed" {
+		t.Fatalf("rig molecule = %q, want closed", current.Status)
+	}
+	if city.reads != 0 {
+		t.Fatalf("city root reads = %d, want zero for exact rig graph scope", city.reads)
+	}
+}
