+		other.ID = ""
+		if _, err = s.Create(other); err != nil {
+			return false, err
+		}
+		if err = s.SetMetadata(id, key, next); err != nil {
+			return false, err
+		}
+		s.won = true
+		return false, nil
+	}
+	return s.MemStore.CompareAndSetMetadataKey(id, key, expected, next)
+}
