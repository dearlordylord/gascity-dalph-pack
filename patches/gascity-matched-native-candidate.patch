+type captureMetadataManyStore struct {
+	beads.Store
+	ids []string
+}
+
+func (s *captureMetadataManyStore) SetMetadataMany(ids []string, key, value string) error {
+	s.ids = append([]string(nil), ids...)
+	if key != "gc.step_defined_emitted" || value != "ack" {
