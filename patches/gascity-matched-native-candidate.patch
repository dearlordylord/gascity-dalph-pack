@@ -160,3 +160,27 @@ func ApplyMetadataCAS(store Store, id, key, expected, next string) (MetadataCASO
 	}
 	return MetadataCASConflict, nil
 }
+
+// ProbeMetadataCAS verifies the existing narrow value-CAS capability without a
+// mutation. BdStore retains its normal per-instance four-verb probe and runtime
+// unsupported latch; no successful result is persisted across store lifetimes.
+func ProbeMetadataCAS(store Store) error {
+	if _, ok := MetadataCASWriterFor(store); !ok {
+		return ErrConditionalWriteUnsupported
+	}
+	store = followConditionalWritesResolveTarget(store)
+	if cached, ok := store.(*CachingStore); ok {
+		return ProbeMetadataCAS(cached.Backing())
+	}
+	if live, ok := store.(conditionalWritesLiveness); ok {
+		if err := live.conditionalWritesStoreOpen(); err != nil {
+			return err
+		}
+	}
+	if probe, ok := store.(conditionalWriteCapabilityProber); ok {
+		if capable, reason := probe.probeConditionalWriteCapability(); !capable {
+			return fmt.Errorf("%w: %s", ErrConditionalWriteUnsupported, reason)
+		}
+	}
+	return nil
+}
