+
+type scopedShowProbeStore struct {
+	beads.Store
+	bead     beads.Bead
+	readErr  error
+	closeErr error
+	gets     int
+	closes   int
+}
+
+func (store *scopedShowProbeStore) Get(string) (beads.Bead, error) {
+	store.gets++
+	return store.bead, store.readErr
+}
+
+func (store *scopedShowProbeStore) CloseStore() error {
+	store.closes++
+	return store.closeErr
+}
+
+func installScopedShowStore(t *testing.T, open func(string, string) (beads.Store, error)) {
+	t.Helper()
+	previous := openBeadsScopedShowStore
+	openBeadsScopedShowStore = open
+	t.Cleanup(func() { openBeadsScopedShowStore = previous })
+}
+
+func TestScopedShowBypassesAPICacheAndPreservesNormalizedBead(t *testing.T) {
+	for _, ephemeral := range []bool{false, true} {
+		t.Run(map[bool]string{false: "persistent", true: "ephemeral"}[ephemeral], func(t *testing.T) {
+			clearGCEnv(t)
+			configureIsolatedRuntimeEnv(t)
+			cityPath := writeMetadataCASTestCity(t)
+			probe := &scopedShowProbeStore{
+				Store: beads.NewMemStore(),
+				bead: beads.Bead{
+					ID: "tr-1", Title: "fresh normalized row", Status: "closed", Ephemeral: ephemeral,
+					Metadata: beads.StringMap{"large": "9007199254740993", "complex": "{ \"nested\": true }", "blank": ""},
+				},
+			}
+			opens := 0
+			installScopedShowStore(t, func(scope, city string) (beads.Store, error) {
+				opens++
+				if scope != filepath.Join(cityPath, "tributary") || city != cityPath {
+					t.Fatalf("wrong store opened: scope=%s city=%s", scope, city)
+				}
+				return probe, nil
+			})
+			previous := beadsShowAPIClient
+			apiCalls := 0
+			beadsShowAPIClient = func(string) (*api.Client, string) { apiCalls++; return nil, "unexpected cache route" }
+			t.Cleanup(func() { beadsShowAPIClient = previous })
+			writer := &scopedShowOrderWriter{store: probe}
+			var stderr bytes.Buffer
+			code := run([]string{"--city", cityPath, "beads", "show", "tr-1", "--store-ref=rig:tributary", "--format=json"}, writer, &stderr)
+			var expected bytes.Buffer
+			writeBeadJSON(probe.bead, &expected)
+			if code != 0 || opens != 1 || probe.gets != 1 || probe.closes != 1 || apiCalls != 0 || writer.buffer.String() != expected.String() {
+				t.Fatalf("incorrect scoped projection: exit=%d opens=%d gets=%d closes=%d api=%d stdout=%q stderr=%q", code, opens, probe.gets, probe.closes, apiCalls, writer.buffer.String(), stderr.String())
+			}
+		})
+	}
+}
+
+type scopedShowOrderWriter struct {
+	store  *scopedShowProbeStore
+	buffer bytes.Buffer
+	fail   bool
+}
+
+func (writer *scopedShowOrderWriter) Write(value []byte) (int, error) {
+	if writer.store.closes != 1 {
+		return 0, errors.New("output before owned close")
+	}
+	if writer.fail {
+		return 0, errors.New("output failed")
+	}
+	return writer.buffer.Write(value)
+}
+
+func TestScopedShowRefusesReadIdentityCloseAndOutputFailures(t *testing.T) {
+	for _, boundary := range []string{"open", "read", "identity", "close", "read and close", "output"} {
+		t.Run(boundary, func(t *testing.T) {
+			clearGCEnv(t)
+			configureIsolatedRuntimeEnv(t)
+			cityPath := writeMetadataCASTestCity(t)
+			probe := &scopedShowProbeStore{Store: beads.NewMemStore(), bead: beads.Bead{ID: "tr-1"}}
+			if boundary == "read" || boundary == "read and close" {
+				probe.readErr = errors.New("read failed")
+			}
+			if boundary == "close" || boundary == "read and close" {
+				probe.closeErr = errors.New("close failed")
+			}
+			if boundary == "identity" {
+				probe.bead.ID = "tr-other"
+			}
+			installScopedShowStore(t, func(string, string) (beads.Store, error) {
+				if boundary == "open" {
+					return nil, errors.New("open failed")
+				}
+				return probe, nil
+			})
+			writer := &scopedShowOrderWriter{store: probe, fail: boundary == "output"}
+			var stderr bytes.Buffer
+			code := run([]string{"--city", cityPath, "beads", "show", "tr-1", "--store-ref=rig:tributary", "--format=json"}, writer, &stderr)
+			wantCloses := 1
+			if boundary == "open" {
+				wantCloses = 0
+			}
+			if code == 0 || writer.buffer.Len() != 0 || probe.closes != wantCloses || stderr.Len() == 0 {
+				t.Fatalf("failure leaked success or custody: exit=%d closes=%d stdout=%q stderr=%q", code, probe.closes, writer.buffer.String(), stderr.String())
+			}
+			if boundary == "read and close" && (!strings.Contains(stderr.String(), "read failed") || !strings.Contains(stderr.String(), "close failed")) {
+				t.Fatalf("lost a boundary failure: %q", stderr.String())
+			}
+		})
+	}
+}
+
+func TestScopedShowRefusesInvalidForeignAndRemoteInputsBeforeOpening(t *testing.T) {
+	for _, input := range []struct {
+		name, id, ref, format string
+		remote                bool
+	}{
+		{name: "empty locator", id: "tr-1", format: "json"},
