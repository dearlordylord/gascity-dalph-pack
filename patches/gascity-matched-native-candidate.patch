+// ResumeAttachActivation finishes one exact attach and its original epoch fence.
+// It never instantiates a recipe: missing or ambiguous members
+// retain the held graph for reconciliation rather than create a replacement.
+func ResumeAttachActivation(store beads.Store, recipe *formula.Recipe, controlID, candidateID, key string, expectedEpoch int) (*AttachResult, error) {
+	if recipe == nil || len(recipe.Steps) == 0 || expectedEpoch < 1 || key == "" {
+		return nil, fmt.Errorf("invalid attach recovery identity")
+	}
+	control, err := store.Get(controlID)
+	if err != nil {
+		return nil, err
+	}
+	if control.Status == "closed" || (control.Metadata[beadmeta.ControlEpochMetadataKey] != strconv.Itoa(expectedEpoch+1) &&
+		control.Metadata[beadmeta.ControlEpochMetadataKey] != strconv.Itoa(expectedEpoch)) {
+		return nil, ErrEpochConflict
+	}
+	workflowID := beadmeta.ResolveRunID(control.Metadata, controlID, "")
+	workflow, err := store.Get(workflowID)
+	if err != nil {
+		return nil, err
+	}
+	if workflow.Status == "closed" {
+		return nil, ErrEpochConflict
+	}
+	candidate, err := store.Get(candidateID)
+	if err != nil {
+		return nil, err
+	}
+	if candidate.Status == "closed" || candidate.Metadata[beadmeta.RootBeadIDMetadataKey] != workflowID ||
+		candidate.Metadata[beadmeta.RootStoreRefMetadataKey] != control.Metadata[beadmeta.RootStoreRefMetadataKey] ||
+		candidate.Metadata[beadmeta.IdempotencyKeyMetadataKey] != key ||
+		(candidate.Metadata[beadmeta.AttachFencePendingMetadataKey] != attachFencePendingActivating && candidate.Metadata[beadmeta.AttachFencePendingMetadataKey] != attachFencePendingUnclaimed) {
+		return nil, fmt.Errorf("attach recovery candidate does not match its committed owner: %w", ErrEpochConflict)
+	}
+	all, err := store.List(beads.ListQuery{Metadata: map[string]string{beadmeta.RootBeadIDMetadataKey: workflowID}, TierMode: beads.TierBoth})
+	if err != nil {
+		return nil, err
+	}
+	matches := 0
+	for _, b := range all {
+		if b.Metadata[beadmeta.IdempotencyKeyMetadataKey] == key && b.Metadata[beadmeta.MoleculeFailedMetadataKey] != "true" && b.Metadata[beadmeta.AttachFencePendingMetadataKey] != attachFencePendingFailed {
+			matches++
+		}
+	}
+	if matches != 1 {
+		return nil, fmt.Errorf("attach recovery candidate is ambiguous")
+	}
+	rootMatches := false
+	rootRef := strings.TrimSpace(candidate.Metadata[beadmeta.StepRefMetadataKey])
+	if rootRef == "" {
+		rootRef = strings.TrimSpace(candidate.Ref)
+	}
+	for _, ref := range attachStepRefs(recipe.Steps[0]) {
+		if rootRef == ref {
+			rootMatches = true
+		}
+	}
+	if !rootMatches {
+		return nil, fmt.Errorf("attach recovery root differs from the authored recipe")
+	}
+	mapping := make(map[string]string, len(recipe.Steps))
+	for i, step := range recipe.Steps {
+		if i == 0 || step.IsRoot {
+			mapping[step.ID] = candidate.ID
+			continue
+		}
+		for _, b := range all {
+			ref := strings.TrimSpace(b.Metadata[beadmeta.StepRefMetadataKey])
+			if ref == "" {
+				ref = strings.TrimSpace(b.Ref)
+			}
+			for _, wanted := range attachStepRefs(step) {
+				if ref != wanted {
+					continue
+				}
+				if mapping[step.ID] != "" && mapping[step.ID] != b.ID {
+					return nil, fmt.Errorf("attach recovery member %s is ambiguous", step.ID)
+				}
+				if b.Metadata[beadmeta.RootStoreRefMetadataKey] != candidate.Metadata[beadmeta.RootStoreRefMetadataKey] || b.Metadata[beadmeta.MoleculeFailedMetadataKey] == "true" {
+					return nil, fmt.Errorf("attach recovery member %s belongs to another authority", step.ID)
+				}
+				mapping[step.ID] = b.ID
+			}
+		}
+		if mapping[step.ID] == "" {
+			return nil, fmt.Errorf("attach recovery member %s is missing", step.ID)
+		}
+	}
+	writer, _, err := beads.ResolveConditionalWriter(store)
+	if err != nil {
+		return nil, err
+	}
+	if writer == nil {
+		return nil, fmt.Errorf("attach recovery requires a conditional writer")
+	}
+	if control.Metadata[beadmeta.ControlEpochMetadataKey] == strconv.Itoa(expectedEpoch) &&
+		candidate.Metadata[beadmeta.AttachFencePendingMetadataKey] != attachFencePendingUnclaimed {
+		return nil, ErrEpochConflict
+	}
+	// Restore the exact edge before publishing routes, then re-read the epoch.
+	// Use the validated mapping rather than a second permissive member lookup.
+	deps, err := store.DepList(controlID, "down")
+	if err != nil {
+		return nil, err
+	}
+	blocked := false
+	for _, dep := range deps {
+		if dep.DependsOnID == candidateID && dep.Type == "blocks" {
+			blocked = true
+		}
+	}
+	if !blocked {
+		if err := store.DepAdd(controlID, candidateID, "blocks"); err != nil {
+			return nil, err
+		}
+	}
+	if control.Metadata[beadmeta.ControlEpochMetadataKey] == strconv.Itoa(expectedEpoch) {
+		ok, casErr := writer.CompareAndSetMetadataKey(controlID, beadmeta.ControlEpochMetadataKey,
+			strconv.Itoa(expectedEpoch), strconv.Itoa(expectedEpoch+1))
+		if !ok {
+			if casErr != nil && !beads.IsPreconditionFailed(casErr) {
+				return nil, casErr
+			}
+			// The epoch alone cannot identify which candidate won the fence.
+			// Reconcile candidates afresh before publishing any route.
+			return nil, ErrEpochConflict
+		}
+	}
+	control, err = store.Get(controlID)
+	if err != nil {
+		return nil, err
+	}
+	if control.Status == "closed" || control.Metadata[beadmeta.ControlEpochMetadataKey] != strconv.Itoa(expectedEpoch+1) {
+		return nil, ErrEpochConflict
+	}
+	if err := activateAttachCandidate(store, candidateID, mapping); err != nil {
+		return nil, err
+	}
+	return &AttachResult{RootID: candidateID, WorkflowRootID: workflowID, IDMapping: mapping, Duplicate: true}, nil
+}
