{
  "name": "gascity-dalph-pack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.106",
    "cytoscape": "^3.34.3",
    "cytoscape-dagre": "^4.0.1",
    "effect": "4.0.0-beta.106"
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tests -v",
