{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "import"
  ],
  "jsPlugins": [
    {
      "name": "dalph",
      "specifier": "./dist/quality/lint-plugin.js"
    }
  ],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "**/dist",
    "**/build",
    "**/coverage",
    "**/*.md",
    "**/.reference",
    ".ralph/**"
  ],
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "no-array-constructor": "error",
    "no-unused-expressions": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-imports": "warn",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/triple-slash-reference": "error",
    "import/first": "error",
    "import/no-duplicates": "error",
    "object-shorthand": "error",
    "dalph/sort-destructure-keys": "error",
    "max-lines": [
      "error",
      {
        "max": 420,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "no-console": "error",
    "no-magic-numbers": [
      "warn",
      {
        "ignore": [
          0,
          1,
          1024
        ],
        "ignoreArrayIndexes": true,
        "ignoreDefaultValues": true,
        "ignoreEnums": true,
        "ignoreNumericLiteralTypes": true,
        "ignoreTypeIndexes": true,
        "enforceConst": true
      }
    ],
    "dalph/no-clock-read": "error",
    "dalph/no-double-type-assertion": "error",
    "dalph/no-schema-primitive": "error",
    "dalph/no-test-mocks": "error",
    "dalph/no-type-assertion": "error",
    "dalph/require-canonical-effect-schema-import": "error"
  },
  "overrides": [
    {
      "files": [
        "src/domain/shared.ts"
      ],
      "rules": {
        "dalph/no-schema-primitive": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "test/**/*.ts"
      ],
      "rules": {
        "max-lines": "off",
        "no-magic-numbers": "off",
        "typescript/no-non-null-assertion": "warn",
        "typescript/no-unnecessary-type-assertion": "off",
        "dalph/no-type-assertion": "off",
        "dalph/property-test-placement": "error"
      }
    }
  ]
}
